# Copier vers .env et adapter. .env est dans .gitignore — jamais commité.
DATABASE_URL="mysql://root:@localhost:3306/bara?charset=utf8mb4"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-random-64-char-secret"

PORT=4100
NODE_ENV=development
WEB_APP_URL="http://localhost:3100"

# Dossier de stockage privé des pièces d'identité — hors de tout dossier
# servi publiquement, jamais commité (voir .gitignore).
UPLOAD_DIR="./uploads/private"
